        </mxCell>
        <mxCell id="progress" value="&lt;b&gt;PROGRESS_UPDATE&lt;/b&gt;&lt;br&gt;PK update_id · FK project_id&lt;br&gt;github_url, summary, shared_at&lt;br&gt;feedback, feedback_at (optional)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
          <mxGeometry as="geometry" x="795" y="155" width="310" height="128" />
        </mxCell>
        <mxCell id="chapter" value="&lt;b&gt;CHAPTER&lt;/b&gt;&lt;br&gt;PK chapter_id · FK project_id&lt;br&gt;chapter_no, title&lt;br&gt;UQ (project_id, chapter_no)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
