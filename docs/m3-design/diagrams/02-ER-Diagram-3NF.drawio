        <mxCell id="r4" value="1 → 0..1" edge="1" parent="1" source="version" target="review" style="html=1;endArrow=block;strokeColor=#23645B;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="Submitted is derived when the latest version has no review. Otherwise its review determines the latest status.&lt;br&gt;The latest version is the highest version number. Chapter files and decisions remain attached to their version." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
