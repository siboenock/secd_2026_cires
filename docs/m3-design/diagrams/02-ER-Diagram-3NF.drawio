        <mxCell id="title" value="&lt;b&gt;Thesis review data model&lt;/b&gt;&lt;br&gt;PK primary key · FK foreign key · UQ unique constraint" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#183738;strokeColor=none;fontColor=#ffffff;align=left;spacingLeft=18;fontSize=21;">
          <mxGeometry as="geometry" x="35" y="25" width="1120" height="76" />
        </mxCell>
        <mxCell id="account" value="&lt;b&gt;ACCOUNT&lt;/b&gt;&lt;br&gt;PK account_id&lt;br&gt;UQ email&lt;br&gt;display_name, password_hash, role" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
          <mxGeometry as="geometry" x="40" y="155" width="310" height="128" />
        </mxCell>
        <mxCell id="project" value="&lt;b&gt;PROJECT&lt;/b&gt;&lt;br&gt;PK project_id&lt;br&gt;FK student_id → ACCOUNT&lt;br&gt;FK supervisor_id → ACCOUNT&lt;br&gt;title" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
