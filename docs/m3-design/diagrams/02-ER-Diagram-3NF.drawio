        </mxCell>
        <mxCell id="version" value="&lt;b&gt;CHAPTER_VERSION&lt;/b&gt;&lt;br&gt;PK version_id · FK chapter_id&lt;br&gt;version_no, file_key, filename, submitted_at&lt;br&gt;UQ (chapter_id, version_no)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
          <mxGeometry as="geometry" x="400" y="565" width="310" height="128" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;VERSION_REVIEW&lt;/b&gt;&lt;br&gt;PK/FK version_id&lt;br&gt;decision, feedback, reviewed_at" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F0;strokeColor=#79938C;fontColor=#193B3A;fontSize=15;align=left;spacingLeft=14;">
