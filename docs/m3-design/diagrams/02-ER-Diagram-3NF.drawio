        <mxCell id="r1" value="1 → 0..*" edge="1" parent="1" source="project" target="progress" style="html=1;endArrow=block;strokeColor=#23645B;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;">
