        <mxCell id="r0" value="1 → 0..* per assignment role" edge="1" parent="1" source="account" target="project" style="html=1;endArrow=block;strokeColor=#23645B;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry as="geometry" relative="1" />
