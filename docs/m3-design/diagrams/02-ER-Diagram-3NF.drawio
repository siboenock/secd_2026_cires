        <mxCell id="r2" value="1 → 0..*" edge="1" parent="1" source="project" target="chapter" style="html=1;endArrow=block;strokeColor=#23645B;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="r3" value="1 → 1..*" edge="1" parent="1" source="chapter" target="version" style="html=1;endArrow=block;strokeColor=#23645B;fontSize=13;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;">
          <mxGeometry as="geometry" relative="1" />
